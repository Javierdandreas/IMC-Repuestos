# Configuración de Base de Datos (PostgreSQL)
# Utilizada para conexiones directas desde el servidor (Repositorios)
DATABASE_URL=postgres://usuario:password@host:port/database

# Configuración de Supabase (Cliente Público)
# Utilizada para Auth (JS Client) y Storage (Imágenes)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-de-supabase

# Nota: Estas variables deben configurarse en el panel de control 
# de tu hosting (Vercel, Railway, etc.) para que la app funcione.
